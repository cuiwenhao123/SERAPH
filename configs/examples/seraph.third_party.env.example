# Example third-party model configuration for SERAPH.
#
# Copy the values you need into an ignored local file such as:
#   configs/environments/.env.seraph-local
# Then load it with:
#   set -a && source configs/environments/.env.seraph-local && set +a

# Phase 2 embedding backend
export SERAPH_EMBEDDING_BACKEND='openai_compatible'
export SERAPH_EMBEDDING_BASE_URL='https://api.siliconflow.cn/v1'
export SERAPH_EMBEDDING_MODEL='Qwen/Qwen3-Embedding-8B'
export SERAPH_EMBEDDING_API_KEY='replace-with-your-embedding-api-key'
# Copy exactly one token. A duplicated value like `sk-...sk-...` will be rejected.

# Optional embedding overrides
# export SERAPH_EMBEDDING_API_PATH='/embeddings'
# export SERAPH_EMBEDDING_TIMEOUT_SECONDS='180'
# export SERAPH_EMBEDDING_EXTRA_HEADERS='{}'
# export SERAPH_EMBEDDING_EXTRA_BODY='{}'

# Phase 3 LLM backend
export SERAPH_LLM_BASE_URL='http://127.0.0.1:8080'
export SERAPH_LLM_MODEL='gpt-5.4'
export SERAPH_LLM_WIRE_API='responses'
export SERAPH_LLM_API_KEY='replace-with-your-llm-api-key'
